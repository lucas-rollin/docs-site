<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ site_title | e }} — Docs</title>
    <link rel="stylesheet" href="static/css/shell.css">
  </head>
  <body>
    <header>
      <button id="nav-toggle-btn"
              type="button"
              aria-label="Toggle file navigation"
              aria-controls="left-panel"
              aria-expanded="false"
              title="Files">
        <svg class="icon"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
      <div class="site-title">{{ site_title | e }}</div>
      <div class="search-wrap">
        <input id="search-input"
               type="text"
               placeholder="Search all files…"
               autocomplete="off">
        <div id="search-results" role="listbox"></div>
      </div>
      <div class="toc-dropdown-wrap">
        <button id="toc-toggle-btn"
                type="button"
                aria-label="On this page"
                aria-controls="toc-popover"
                aria-expanded="false"
                title="On this page">
          <svg class="icon"
               viewBox="0 0 24 24"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               stroke-linecap="round"
               stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6" />
            <line x1="8" y1="12" x2="21" y2="12" />
            <line x1="8" y1="18" x2="21" y2="18" />
            <line x1="3" y1="6" x2="3.01" y2="6" />
            <line x1="3" y1="12" x2="3.01" y2="12" />
            <line x1="3" y1="18" x2="3.01" y2="18" />
          </svg>
          <span class="toc-btn-label">On this page</span>
        </button>
        <div id="toc-popover" role="region" aria-label="On this page">
          <div class="panel-heading">On this page</div>
          <div id="toc-popover-body" class="toc-empty">Select a file to see its contents.</div>
        </div>
      </div>
      <button id="copy-page-btn"
              type="button"
              disabled
              title="Copy current page as Markdown"
              aria-label="Copy current page as Markdown">
        <svg class="icon icon-copy"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <span>Copy Page</span>
      </button>
      <button id="dark-toggle"
              type="button"
              title="Toggle dark mode"
              aria-label="Toggle dark mode">
        <svg class="icon icon-moon"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <span>Dark</span>
      </button>
    </header>
    <div id="drawer-backdrop" aria-hidden="true"></div>
    <nav id="left-panel" aria-label="Document navigation">
    </nav>
    <main>
      <iframe id="content-frame"
              title="Welcome page"
              src="pages/{{ welcome_file }}"></iframe>
    </main>
    <aside id="right-panel">
      <div class="panel-heading">On this page</div>
      <div id="toc-body" class="toc-empty">Select a file to see its contents.</div>
    </aside>
    <div id="copy-toast" role="status" aria-live="polite"></div>
    <script>window.DOCS_MANIFEST = {{ manifest_json }};</script>
    <script src="static/js/minisearch.min.js"></script>
    <script src="static/js/shell.js"></script>
  </body>
</html>
