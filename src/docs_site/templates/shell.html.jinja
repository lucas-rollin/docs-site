<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ site_title }} — Docs</title>
    <link rel="stylesheet" href="static/css/shell.css">
  </head>
  <body>
    <header>
      <div class="site-title">{{ site_title }}</div>
      <div class="search-wrap">
        <input id="search-input"
               type="text"
               placeholder="Search all files…"
               autocomplete="off">
        <div id="search-results"></div>
      </div>
      <a href="llms.txt" target="_blank" class="llms-badge" title="LLM-friendly documentation format">
        <svg class="icon icon-bot" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg>
        <span>llms.txt</span>
      </a>
      <button id="dark-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <span>Dark</span>
      </button>
    </header>
    <nav id="left-panel">
    </nav>
    <main>
      <iframe id="content-frame"
              title="Welcome page"
              src="pages/{{ welcome_file }}"></iframe>
    </main>
    <aside id="right-panel">
      <div class="panel-heading">On this page</div>
      <div id="toc-body" class="toc-empty">Select a file to see its contents.</div>
    </aside>
    <div id="copy-toast" role="status" aria-live="polite"></div>
    <script>window.DOCS_MANIFEST = {{ manifest_json }};</script>
    <script src="static/js/minisearch.min.js"></script>
    <script src="static/js/shell.js"></script>
  </body>
</html>
